{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": [
    "index.ts",
    "Atoolkit/**/*.ts",
    "WeebGfx/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".tsc-dist",
    ".vite",
    "archive"
  ]
}