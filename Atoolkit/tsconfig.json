{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["@webgpu/types"],
		"outDir": "./dist",
		"rootDir": ".",
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"**/*.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"**/*.test.ts",
		"**/*.spec.ts"
	]
}
