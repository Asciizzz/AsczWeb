{
	"name": "@asciiz/atoolkit",
	"version": "0.2.0",
	"description": "Computational and graphics engineering toolkit for WebGPU, WebAssembly, linear algebra, ECS, temporal curves, and dataflow circuits.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./alm": {
			"types": "./dist/alm/index.d.ts",
			"import": "./dist/alm/index.js"
		},
		"./alm/*": {
			"types": "./dist/alm/*.d.ts",
			"import": "./dist/alm/*.js"
		},
		"./awgpu": {
			"types": "./dist/awgpu/index.d.ts",
			"import": "./dist/awgpu/index.js"
		},
		"./awgpu/*": {
			"types": "./dist/awgpu/*.d.ts",
			"import": "./dist/awgpu/*.js"
		},
		"./awasm": {
			"types": "./dist/awasm/index.d.ts",
			"import": "./dist/awasm/index.js"
		},
		"./awasm/*": {
			"types": "./dist/awasm/*.d.ts",
			"import": "./dist/awasm/*.js"
		},
		"./aecs": {
			"types": "./dist/aecs/index.d.ts",
			"import": "./dist/aecs/index.js"
		},
		"./aecs/*": {
			"types": "./dist/aecs/*.d.ts",
			"import": "./dist/aecs/*.js"
		},
		"./atempo": {
			"types": "./dist/atempo/index.d.ts",
			"import": "./dist/atempo/index.js"
		},
		"./atempo/*": {
			"types": "./dist/atempo/*.d.ts",
			"import": "./dist/atempo/*.js"
		},
		"./acircuit": {
			"types": "./dist/acircuit/index.d.ts",
			"import": "./dist/acircuit/index.js"
		},
		"./acircuit/*": {
			"types": "./dist/acircuit/*.d.ts",
			"import": "./dist/acircuit/*.js"
		},
		"./adiag": {
			"types": "./dist/adiag/index.d.ts",
			"import": "./dist/adiag/index.js"
		},
		"./adiag/*": {
			"types": "./dist/adiag/*.d.ts",
			"import": "./dist/adiag/*.js"
		}
	},
	"files": [
		"dist",
		"ReadMe.md",
		"*/ReadMe.md",
		"MIGRATION.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "node -e \"const fs=require('node:fs'),path=require('node:path');const d=path.resolve(process.cwd(),'dist');if(path.basename(d)==='dist'&&path.basename(process.cwd())==='Atoolkit')fs.rmSync(d,{recursive:true,force:true});\"",
		"build": "npm run clean && tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepack": "npm run build",
		"prepublishOnly": "npm run build"
	},
	"author": "Asciizzz",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Asciizzz/AsczWeb.git",
		"directory": "Atoolkit"
	},
	"keywords": [
		"webgpu",
		"webassembly",
		"wasm",
		"graphics",
		"math",
		"ecs"
	],
	"devDependencies": {
		"@webgpu/types": "^0.1.71",
		"typescript": "^5.4.0"
	}
}
